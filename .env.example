# Postgres
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=portfolio
POSTGRES_DB=portfolio
POSTGRES_DB_STAGING=portfolio_staging
POSTGRES_PORT=5432

# Backend (production profile)
CORS_ORIGIN=http://localhost:8080
GITHUB_USERNAME=octocat
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=300

# Resend (https://resend.com) — powers contact-form notification emails, shared by both profiles.
# Required at boot (Joi validation) — fill these in before starting the backend.
RESEND_API_KEY=
CONTACT_FROM_EMAIL="onboarding@resend.dev"
CONTACT_NOTIFICATION_EMAIL="you@example.com"

# Backend (staging profile)
CORS_ORIGIN_STAGING=http://localhost:8081

# Frontend (build-time only, see claude/architecture.md)
VITE_API_BASE_URL=http://localhost:3000
VITE_API_BASE_URL_STAGING=http://localhost:3001
