DATABASE_URL="postgresql://portfolio:portfolio@localhost:5432/portfolio?schema=public"

PORT=3000
CORS_ORIGIN="http://localhost:5173"

# Public GitHub username the activity widget proxies. Server-controlled — never accepted from the client.
GITHUB_USERNAME="octocat"
# Optional: raises the GitHub API rate limit from 60/hr to 5000/hr. Leave empty to use unauthenticated requests.
GITHUB_TOKEN=
GITHUB_CACHE_TTL_SECONDS=300

# Resend (https://resend.com) — powers contact-form notification emails.
# Required at boot (Joi validation) — fill these in before starting the backend.
RESEND_API_KEY=
# Sender address. Use "onboarding@resend.dev" for local dev until a sending domain is verified.
CONTACT_FROM_EMAIL="onboarding@resend.dev"
# Inbox that receives a notification for every contact-form submission.
CONTACT_NOTIFICATION_EMAIL="you@example.com"
